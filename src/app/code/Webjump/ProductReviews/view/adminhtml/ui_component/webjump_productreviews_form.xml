<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array"><item name="provider" xsi:type="string">webjump_productreviews_form.review_form_data_source</item></item>
        <item name="label" xsi:type="string" translate="true">Avaliação</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Webjump\ProductReviews\Block\Adminhtml\Review\Edit\BackButton"/>
            <button name="save" class="Webjump\ProductReviews\Block\Adminhtml\Review\Edit\SaveButton"/>
        </buttons>
        <namespace>webjump_productreviews_form</namespace><dataScope>data</dataScope>
        <deps><dep>webjump_productreviews_form.review_form_data_source</dep></deps>
    </settings>
    <dataSource name="review_form_data_source">
        <argument name="data" xsi:type="array"><item name="js_config" xsi:type="array"><item name="component" xsi:type="string">Magento_Ui/js/form/provider</item></item></argument>
        <settings><submitUrl path="webjump_productreviews/review/save"/></settings>
        <aclResource>Webjump_ProductReviews::reviews</aclResource>
        <dataProvider class="Webjump\ProductReviews\Model\Review\DataProvider" name="review_form_data_source">
            <settings><requestFieldName>entity_id</requestFieldName><primaryFieldName>entity_id</primaryFieldName></settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings><label translate="true">Dados da avaliação</label></settings>
<field name="entity_id" formElement="input">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="source" xsi:type="string">review</item></item></argument>
            <settings><dataType>text</dataType><label translate="true">ID</label><dataScope>entity_id</dataScope><visible>false</visible></settings>
        </field>
<field name="customer_name" formElement="input">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="source" xsi:type="string">review</item></item></argument>
            <settings><dataType>text</dataType><label translate="true">Autor</label><dataScope>customer_name</dataScope><validation><rule name="required-entry" xsi:type="boolean">true</rule></validation></settings>
        </field>
<field name="product_sku" formElement="input">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="source" xsi:type="string">review</item></item></argument>
            <settings><dataType>text</dataType><label translate="true">SKU do produto</label><dataScope>product_sku</dataScope><validation><rule name="required-entry" xsi:type="boolean">true</rule></validation></settings>
        </field>
<field name="comment" formElement="textarea">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="source" xsi:type="string">review</item></item></argument>
            <settings><dataType>text</dataType><label translate="true">Comentário</label><dataScope>comment</dataScope><validation><rule name="required-entry" xsi:type="boolean">true</rule></validation></settings>
        </field>
<field name="rating" formElement="select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="source" xsi:type="string">review</item></item></argument>
            <settings><dataType>text</dataType><label translate="true">Nota</label><dataScope>rating</dataScope><validation><rule name="required-entry" xsi:type="boolean">true</rule></validation></settings><formElements><select><settings><options><option name="value_1" xsi:type="array"><item name="value" xsi:type="string">1</item><item name="label" xsi:type="string" translate="true">1</item></option><option name="value_2" xsi:type="array"><item name="value" xsi:type="string">2</item><item name="label" xsi:type="string" translate="true">2</item></option><option name="value_3" xsi:type="array"><item name="value" xsi:type="string">3</item><item name="label" xsi:type="string" translate="true">3</item></option><option name="value_4" xsi:type="array"><item name="value" xsi:type="string">4</item><item name="label" xsi:type="string" translate="true">4</item></option><option name="value_5" xsi:type="array"><item name="value" xsi:type="string">5</item><item name="label" xsi:type="string" translate="true">5</item></option></options></settings></select></formElements>
        </field>
<field name="is_approved" formElement="select">
            <argument name="data" xsi:type="array"><item name="config" xsi:type="array"><item name="source" xsi:type="string">review</item></item></argument>
            <settings><dataType>text</dataType><label translate="true">Aprovada</label><dataScope>is_approved</dataScope><validation><rule name="required-entry" xsi:type="boolean">true</rule></validation></settings><formElements><select><settings><options><option name="value_0" xsi:type="array"><item name="value" xsi:type="string">0</item><item name="label" xsi:type="string" translate="true">Não</item></option><option name="value_1" xsi:type="array"><item name="value" xsi:type="string">1</item><item name="label" xsi:type="string" translate="true">Sim</item></option></options></settings></select></formElements>
        </field>
    </fieldset>
</form>
