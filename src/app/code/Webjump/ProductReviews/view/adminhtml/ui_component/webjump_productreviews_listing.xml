<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">webjump_productreviews_listing.webjump_productreviews_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons><button name="add"><url path="webjump_productreviews/review/new"/><class>primary</class><label translate="true">Nova avaliação</label></button></buttons>
        <spinner>review_columns</spinner>
        <deps><dep>webjump_productreviews_listing.webjump_productreviews_listing_data_source</dep></deps>
    </settings>
    <dataSource name="webjump_productreviews_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig><param name="indexField" xsi:type="string">entity_id</param></storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Webjump_ProductReviews::reviews</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="webjump_productreviews_listing_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <settings>
                <selectProvider>webjump_productreviews_listing.webjump_productreviews_listing.review_columns.ids</selectProvider>
                <indexField>entity_id</indexField>
            </settings>
            <action name="approve">
                <settings>
                    <type>approve</type>
                    <label translate="true">Aprovar selecionadas</label>
                    <url path="webjump_productreviews/review/massApprove"/>
                    <confirm>
                        <title translate="true">Aprovar avaliações</title>
                        <message translate="true">Deseja aprovar as avaliações selecionadas?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
        <exportButton name="export_button" class="Webjump\ProductReviews\Ui\Component\ExportButton">
            <settings>
                <selectProvider>webjump_productreviews_listing.webjump_productreviews_listing.review_columns.ids</selectProvider>
            </settings>
        </exportButton>
    </listingToolbar>
    <columns name="review_columns">
        <selectionsColumn name="ids" sortOrder="10">
            <settings><indexField>entity_id</indexField></settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="20">
            <settings><filter>textRange</filter><sorting>desc</sorting><label translate="true">ID</label></settings>
        </column>
        <column name="customer_name" sortOrder="30">
            <settings><filter>text</filter><label translate="true">Autor</label></settings>
        </column>
        <column name="product_sku" sortOrder="40">
            <settings><filter>text</filter><label translate="true">SKU do produto</label></settings>
        </column>
        <column name="rating" sortOrder="50">
            <settings><filter>textRange</filter><dataType>number</dataType><label translate="true">Nota</label></settings>
        </column>
        <column name="comment" sortOrder="60">
            <settings><filter>text</filter><label translate="true">Comentário</label></settings>
        </column>
        <column name="is_approved" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter><dataType>select</dataType><label translate="true">Aprovada</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings><filter>dateRange</filter><dataType>date</dataType><label translate="true">Criada em</label></settings>
        </column>
    
        <actionsColumn name="actions" class="Webjump\ProductReviews\Ui\Component\Listing\Column\ReviewActions" sortOrder="90">
            <settings><indexField>entity_id</indexField><label translate="true">Ações</label></settings>
        </actionsColumn>
    </columns>
</listing>
