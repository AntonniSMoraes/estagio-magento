<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="webjump_product_reviews" resource="default" engine="innodb" comment="Webjump Product Reviews Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="customer_name" nullable="false" length="255" comment="Customer Name"/>
        <column xsi:type="varchar" name="product_sku" nullable="false" length="64" comment="Product SKU"/>
        <column xsi:type="smallint" name="rating" unsigned="true" nullable="false" comment="Rating (1 to 5)"/>
        <column xsi:type="text" name="comment" nullable="false" comment="Review Comment"/>
        <column xsi:type="boolean" name="is_approved" nullable="false" default="0" comment="Is Approved"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Creation Time"/>
        
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="WEBJUMP_PRODUCT_REVIEWS_SKU" indexType="btree">
            <column name="product_sku"/>
        </index>
    </table>
</schema>