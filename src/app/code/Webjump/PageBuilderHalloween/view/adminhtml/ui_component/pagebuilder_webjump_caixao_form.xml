<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd" extends="pagebuilder_base_form">
  <argument name="data" xsi:type="array">
    <item name="js_config" xsi:type="array">
      <item name="provider" xsi:type="string">pagebuilder_webjump_caixao_form.pagebuilder_webjump_caixao_form_data_source</item>
    </item>
    <item name="label" xsi:type="string" translate="true">Caixão de Ofertas</item>
  </argument>
  <settings>
    <deps>
      <dep>pagebuilder_webjump_caixao_form.pagebuilder_webjump_caixao_form_data_source</dep>
    </deps>
    <namespace>pagebuilder_webjump_caixao_form</namespace>
  </settings>
  <dataSource name="pagebuilder_webjump_caixao_form_data_source">
    <argument name="data" xsi:type="array">
      <item name="js_config" xsi:type="array">
        <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
      </item>
    </argument>
    <dataProvider name="pagebuilder_webjump_caixao_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
      <settings>
        <requestFieldName />
        <primaryFieldName />
      </settings>
    </dataProvider>
  </dataSource>
  <fieldset name="general" sortOrder="10">
    <settings>
      <label translate="true">Caixão de Ofertas</label>
      <opened>true</opened>
    </settings>
    <field name="appearance" formElement="input">
      <argument name="data" xsi:type="array">
        <item name="config" xsi:type="array">
          <item name="default" xsi:type="string">default</item>
        </item>
      </argument>
      <settings>
        <visible>false</visible>
        <dataScope>appearance</dataScope>
      </settings>
    </field>
    <field name="titulo" formElement="input" sortOrder="10">
      <argument name="data" xsi:type="array">
        <item name="config" xsi:type="array">
          <item name="default" xsi:type="string">Caixão de Ofertas</item>
        </item>
      </argument>
      <settings>
        <label translate="true">Título</label>
        <dataType>text</dataType>
        <dataScope>titulo</dataScope>
      </settings>
    </field>
    <field name="descricao" formElement="textarea" sortOrder="20">
      <argument name="data" xsi:type="array">
        <item name="config" xsi:type="array">
          <item name="default" xsi:type="string">Descubra ofertas de arrepiar.</item>
        </item>
      </argument>
      <settings>
        <label translate="true">Descrição</label>
        <dataType>text</dataType>
        <dataScope>descricao</dataScope>
      </settings>
    </field>
    <field name="button_text" formElement="input" sortOrder="50">
      <argument name="data" xsi:type="array">
        <item name="config" xsi:type="array">
          <item name="default" xsi:type="string">Explorar ofertas</item>
        </item>
      </argument>
      <settings>
        <label translate="true">Texto do botão</label>
        <dataType>text</dataType>
        <dataScope>button_text</dataScope>
      </settings>
    </field>
    <field name="alt" formElement="input" sortOrder="60">
      <argument name="data" xsi:type="array">
        <item name="config" xsi:type="array">
          <item name="default" xsi:type="string" />
        </item>
      </argument>
      <settings>
        <label translate="true">Texto alternativo da imagem</label>
        <dataType>text</dataType>
        <dataScope>alt</dataScope>
      </settings>
    </field>
    <field name="image" formElement="imageUploader" sortOrder="30">
      <settings>
        <label translate="true">Imagem</label>
        <componentType>imageUploader</componentType>
      </settings>
      <formElements>
        <imageUploader>
          <settings>
            <allowedExtensions>jpg jpeg gif png</allowedExtensions>
            <maxFileSize>4194304</maxFileSize>
            <uploaderConfig>
              <param xsi:type="string" name="url">pagebuilder/contenttype/image_upload</param>
            </uploaderConfig>
            <previewTmpl>Magento_PageBuilder/form/element/uploader/preview</previewTmpl>
          </settings>
        </imageUploader>
      </formElements>
    </field>
    <urlInput name="link_url" sortOrder="40">
      <settings>
        <dataType>text</dataType>
        <label translate="true">Link da oferta</label>
        <dataScope>link_url</dataScope>
        <urlTypes class="Magento\Ui\Model\UrlInput\LinksConfigProvider" />
      </settings>
    </urlInput>
  </fieldset>
  <fieldset name="advanced">
    <settings>
      <visible>false</visible>
    </settings>
  </fieldset>
</form>