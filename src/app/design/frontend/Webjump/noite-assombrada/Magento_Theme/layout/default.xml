<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo-creepy.png</argument>
                <argument name="logo_alt" xsi:type="string" translate="true">Noite Assombrada</argument>
                <argument name="logo_width" xsi:type="number">250</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="page.wrapper">
            <block class="Magento\Framework\View\Element\Template" name="noite.campaign.banner" template="Magento_Theme::html/campaign.phtml" before="-"/>
        </referenceContainer>
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <move element="breadcrumbs" destination="columns.top" before="page.main.title"/>
        <referenceContainer name="header.panel">
            <block class="Magento\Framework\View\Element\Template"
                   name="noite.modo.interruptor"
                   template="Magento_Theme::html/modo-assombrado.phtml" before="-"/>
        </referenceContainer>
    </body>
</page>