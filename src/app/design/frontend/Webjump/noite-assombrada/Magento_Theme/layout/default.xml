<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo-creepy.png</argument>
                <argument name="logo_alt" xsi:type="string" translate="true">Noite Assombrada</argument>
                <argument name="logo_width" xsi:type="number">250</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>